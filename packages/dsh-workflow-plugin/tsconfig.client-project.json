{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./lib/types",
    "tsBuildInfoFile": "./lib/.tsbuildinfo-client",
    "emitDeclarationOnly": false,
    "types": ["react", "react-dom"]
  },
  "include": ["src/shared/**/*.ts", "src/domain/**/*.ts", "src/client/**/*.ts", "src/client/**/*.tsx"]
}
